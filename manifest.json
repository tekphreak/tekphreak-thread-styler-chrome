{
  "manifest_version": 3,
  "name": "Tekphreak Thread Styler",
  "version": "1.1.0",
  "description": "Style selected text in the Threads composer with real Unicode fonts: bold, italic, mono, small caps and more. No data collected.",
  "author": "Tekphreak",
  "homepage_url": "https://tekphreak.com",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.threads.net/*",
        "*://*.threads.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
